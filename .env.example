# ── Whisper ───────────────────────────────────────────────────────────────────
# Options: tiny, base, small, medium, large, large-v2, large-v3
# base = good quality + fast; large-v3 = best quality (needs 10GB RAM)
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
# Set to "cuda" if you have a GPU

# ── Diarization ───────────────────────────────────────────────────────────────
# Get token from https://huggingface.co/settings/tokens
# Then accept terms at https://hf.co/pyannote/speaker-diarization-3.1
PYANNOTE_TOKEN=

# ── API ───────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
MAX_UPLOAD_SIZE_MB=500

# ── Redis (for async jobs) ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
DEBUG=false
